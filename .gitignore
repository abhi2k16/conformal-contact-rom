# Track only: .py, .json, .npy, .npz, .pkl, plus documents and manuscript sources (.md, .tex, .bib, .txt, paper figures)
# Ignore everything by default, then re-include the allowed types.
*

# Keep directories traversable so nested files can be matched
# (only these folders; their files are still filtered by the allowed types below)
!/contactscreen/
!/scripts/
!/tests/
!/results/
!/results/audits/
!/results/features/
!/results/residuals/
!/results/shift/
!/paper_tools/

# Allowed file types
!*.py
!*.json
!*.npy
!*.npz
!*.pkl
!.gitignore

# Never track these, even though they match above
__pycache__/
.venv/
venv/
.env
paper/

*.egg-info/

# LaTeX build output
*.aux
*.log
*.out
*.toc
*.blg
*.synctex.gz
